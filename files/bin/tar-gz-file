#!/usr/bin/env bash

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "missing file"
  exit 1
fi

archive_name='tmp.tar.gz'
if [ $# -eq 1 ]; then
  archive_name="$(basename -- "$1").tar.gz"
fi

relative_paths=()
for path in "$@"; do
  case "$path" in
    "$PWD"/*)
      relative_paths+=("${path#"$PWD"/}")
      ;;
    *)
      relative_paths+=("$path")
      ;;
  esac
done

tar -czvf "$archive_name" "${relative_paths[@]}"
