#!/usr/bin/env bash
# 用 Neovim 打开文件并优先跳到首个变更行。

set -euo pipefail

file=${1:?missing file path}
line=$(
  git diff --no-ext-diff --unified=0 -- "$file" \
    | sed -n 's/^@@ -[0-9][0-9,]* +\([0-9][0-9]*\).*/\1/p' \
    | head -n1
)

if command -v nvr >/dev/null 2>&1 && [[ -n ${NVIM:-} ]]; then
  target=$(realpath "$file")

  if [[ -n ${line:-} ]]; then
    exec nvr -cc 'close' -c "silent edit +${line} $(printf '%q' "$target")" --remote-silent
  fi

  exec nvr -cc 'close' -c "silent edit $(printf '%q' "$target")" --remote-silent
fi

if [[ -n ${line:-} ]]; then
  exec nvim "+${line}" "$file"
fi

exec nvim "$file"
