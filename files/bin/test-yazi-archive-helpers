#!/usr/bin/env bash

set -euo pipefail

repo_root="$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

mkdir -p "$workdir/project/dir-a" "$workdir/project/dir-b"
printf 'a\n' > "$workdir/project/dir-a/file.txt"
printf 'b\n' > "$workdir/project/dir-b/file.txt"

cd "$workdir/project"

"$repo_root/files/bin/zip-file" "dir-a"
[ -f "dir-a.zip" ]
rm -f "dir-a.zip"

"$repo_root/files/bin/tar-gz-file" "dir-a"
[ -f "dir-a.tar.gz" ]
mkdir extract-single
cd extract-single

tar -xzf ../dir-a.tar.gz
[ -d "dir-a" ]
[ -f "dir-a/file.txt" ]
cd ..
rm -f "dir-a.tar.gz"

"$repo_root/files/bin/zip-file" "dir-a" "dir-b"
[ -f "tmp.zip" ]
rm -f "tmp.zip"

"$repo_root/files/bin/tar-gz-file" "dir-a" "dir-b"
[ -f "tmp.tar.gz" ]
mkdir extract-multi
cd extract-multi

tar -xzf ../tmp.tar.gz
[ -d "dir-a" ]
[ -d "dir-b" ]
[ -f "dir-a/file.txt" ]
[ -f "dir-b/file.txt" ]
cd ..

tar -tzf tmp.tar.gz | grep '^dir-a/'
tar -tzf tmp.tar.gz | grep '^dir-b/'
! tar -tzf tmp.tar.gz | grep '^/'
